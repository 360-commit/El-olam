# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# PostgreSQL via Supabase (recommended) or local
DATABASE_URL="postgresql://postgres:password@localhost:5432/elolam_db?schema=public"

# ─── JWT AUTH ─────────────────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_very_long_random_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend URL (development)
CLIENT_URL=http://localhost:3000
# Frontend URL (production)
CLIENT_URL_PROD=https://app.elolam.edu.gh

# ─── EMAIL (SendGrid or SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@elolam.edu.gh
SMTP_PASS=your_email_app_password
EMAIL_FROM="El-Olam International School <noreply@elolam.edu.gh>"

# ─── FILE UPLOADS (Cloudinary) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── PAYSTACK (Payments - Ghana) ──────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# ─── SMS (Hubtel - Ghana SMS Provider) ───────────────────────────────────────
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_SENDER_ID=ElOlam

# ─── SCHOOL INFO ──────────────────────────────────────────────────────────────
SCHOOL_NAME="El-Olam International School"
SCHOOL_EMAIL=info@elolam.edu.gh
SCHOOL_PHONE=+233200000000




